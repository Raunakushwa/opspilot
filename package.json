{
  "name": "opspilot",
  "private": true,
  "description": "Multi-tenant incident management and AI incident investigation platform",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "turbo run test:integration",
    "evaluate:rag": "bash scripts/evaluate-rag.sh",
    "art": "node scripts/generate-art.mjs"
  },
  "devDependencies": {
    "@opspilot/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3"
  }
}
