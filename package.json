{
  "name": "opspilot",
  "private": true,
  "description": "Multi-tenant incident management and AI incident investigation platform",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@opspilot/config": "workspace:*",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  }
}
