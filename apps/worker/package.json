{
  "name": "@opspilot/worker",
  "version": "0.0.0",
  "private": true,
  "description": "OpsPilot background worker: queues, retries, dead-letter handling",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "LOG_PRETTY=true tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@opspilot/database": "workspace:*",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opspilot/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
