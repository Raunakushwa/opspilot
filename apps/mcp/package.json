{
  "name": "@opspilot/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server exposing OpsPilot's read tools to general-purpose agents",
  "type": "module",
  "bin": {
    "opspilot-mcp": "./dist/server.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opspilot/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
