# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Owner/migrator: runs migrations and provisions roles. Owns every table.
POSTGRES_USER=opspilot_owner
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=opspilot
MIGRATION_DATABASE_URL=postgres://opspilot_owner:change-me-owner-password@postgres:5432/opspilot

# Application login role: data privileges only, no DDL, no RLS bypass.
APP_DB_USER=opspilot_app
APP_DB_PASSWORD=change-me-app-password
DATABASE_URL=postgres://opspilot_app:change-me-app-password@postgres:5432/opspilot

# Host ports for `docker compose`. Override if these are already in use.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333
API_HOST_PORT=4000
WORKER_HOST_PORT=4100
AI_SERVICE_HOST_PORT=8000
WEB_HOST_PORT=3000

# Load the demo organization (Acme Engineering) on startup.
SEED_DEMO=true

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Human-readable logs; `pnpm dev` enables this automatically. Keep false in containers.
LOG_PRETTY=false
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
# Session cookies: Secure is forced in production; enable locally only over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Credential endpoints get a much tighter budget than ordinary routes.
AUTH_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_PORT=4100
WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
APP_ENV=development
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
# Shared secret for worker -> ai-service calls. Required when APP_ENV=production.
INTERNAL_API_TOKEN=local-development-internal-token

# Retrieval. "hashing"/"lexical" need no model download (tests, offline work).
EMBEDDING_PROVIDER=fastembed
RERANKER_PROVIDER=cross-encoder

# LLM provider: one adapter for Groq, OpenAI-compatible endpoints and Ollama.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Web (build-time: Next bakes the proxy destination into the build)
# ---------------------------------------------------------------------------
API_ORIGIN=http://api:4000
